{
  "name": "shadcn-solid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter='@prestgg/*' typecheck",
    "lint": "oxlint packages",
    "build": "bun run --filter='@prestgg/solid-ui' build && bun run --filter='@prestgg/solid-ui-cli' build && bun run --filter='@prestgg/solid-ui-docs' build",
    "registry": "bun run --cwd packages/ui registry",
    "cli": "bun run packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.3"
  }
}