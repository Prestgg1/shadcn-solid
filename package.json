{
  "name": "shadcn-solid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test --conditions=browser",
    "typecheck": "bun run --filter='@prestgg/*' --filter='!@prestgg/solid-ui-docs' typecheck",
    "lint": "oxlint packages apps",
    "registry": "bun run --cwd packages/ui registry",
    "build": "bun run --cwd packages/ui registry && bun run --cwd apps/docs build",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@prestgg/formbox": "0.3.0",
    "@types/bun": "^1.4.2",
    "oxlint": "^1.73.0",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "@prestgg/formbox@0.3.0": "patches/@prestgg+formbox@0.3.0.patch"
  }
}
