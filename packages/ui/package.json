{
  "name": "@prestgg/solid-ui",
  "version": "0.1.0",
  "description": "shadcn/ui for SolidJS. Accessible, copy-paste components with a shadcn-compatible CLI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/ui/*": "./src/ui/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json",
    "./registry.json": "./registry.json",
    "./styles.css": "./src/styles/index.css",
    "./ui/*": "./src/ui/*.tsx"
  },
  "files": [
    "src",
    "registry.json",
    "registry"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --conditions=browser",
    "registry": "bun run ./src/scripts/build-registry.ts",
    "build": "bun run registry"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@prestgg/formbox": ">=0.3.0",
    "@prestgg/solid-jsx": ">=0.1.0",
    "@solidjs/web": ">=2.0.0-rc.13",
    "solid-js": ">=2.0.0-rc.13"
  },
  "peerDependenciesMeta": {
    "@prestgg/formbox": {
      "optional": true
    },
    "@prestgg/solid-jsx": {
      "optional": true
    }
  },
  "keywords": [
    "solidjs",
    "solid-js",
    "shadcn",
    "shadcn-ui",
    "components",
    "tailwind",
    "tailwindcss",
    "accessibility",
    "design-system",
    "cli",
    "ai",
    "llm",
    "solid2"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prestgg1/shadcn-solid.git"
  },
  "bugs": {
    "url": "https://github.com/Prestgg1/shadcn-solid/issues"
  },
  "homepage": "https://github.com/Prestgg1/shadcn-solid#readme",
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@prestgg/solid-jsx": "file:../solid-jsx",
    "@solidjs/compiler": "2.0.0-rc.13",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/web": "2.0.0-rc.13",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5",
    "solid-js": "2.0.0-rc.13",
    "typescript": "^5.9.3"
  }
}
